rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsStudent(studentId) {
      return request.auth != null && request.auth.uid == studentId;
    }
    function validProgress(data) {
      return data is map
        && data.keys().hasOnly(['done', 'stars'])
        && data.done is map
        && data.stars is int && data.stars >= 0 && data.stars <= 150;
    }
    match /students/{studentId} {
      allow read: if ownsStudent(studentId);
      allow create: if ownsStudent(studentId)
        && request.resource.data.keys().hasOnly(['username','displayName','gradeGroup','leaderboardId','progress','createdAt','updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 12
        && request.resource.data.gradeGroup in ['1-2','3-4','5-6']
        && request.resource.data.leaderboardId is string
        && request.resource.data.leaderboardId.matches('^[a-f0-9]{32}$')
        && validProgress(request.resource.data.progress);
      allow update: if ownsStudent(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress','updatedAt','leaderboardId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['leaderboardId']) || !('leaderboardId' in resource.data))
        && (!('leaderboardId' in request.resource.data) || request.resource.data.leaderboardId.matches('^[a-f0-9]{32}$'))
        && validProgress(request.resource.data.progress);
      allow delete: if false;
    }
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.leaderboardId == entryId
        && request.resource.data.keys().hasOnly(['username','stars','updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 150
        && request.resource.data.stars == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.progress.stars;
      allow delete: if false;
    }
  }
}
